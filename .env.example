# Template. Copy to `.env` and fill in your own values.
#
#     cp .env.example .env
#
# `.env` is gitignored. This file is committed, so it must never hold a real value.

# Socrata app token for NYC Open Data.
# Register one at https://data.cityofnewyork.us/profile/edit/developer_settings
#
# The pull runs without it, but anonymous requests are throttled hard and this
# project walks roughly 800k crash rows, so expect to be rate-limited without one.
SOCRATA_APP_TOKEN=your-token-here
